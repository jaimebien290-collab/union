# Copier en .env et remplir avec les valeurs du projet Supabase (Settings → API).
# Uniquement la clé publique « anon » : jamais la clé service_role dans l'app (NF-SEC-02).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Facultatif : DSN Sentry. Vide = Sentry désactivé.
EXPO_PUBLIC_SENTRY_DSN=
