{
  "name": "union",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @union/mobile",
    "admin": "npm run dev --workspace @union/admin",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:db": "vitest run supabase/tests"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
